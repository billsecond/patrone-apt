# Patrone Linux's packages, from billsecond.github.io/patrone-apt (GitHub
# Pages). Patrone Linux installs this file itself, with the key, as
# /etc/apt/sources.list.d/patrone.sources (package patrone-desktop).
Types: deb
URIs: https://billsecond.github.io/patrone-apt
Suites: resolute
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/patrone-archive-keyring.gpg
